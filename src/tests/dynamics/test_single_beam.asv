%% Geometry and flexible beam
Lbeam  = 2.0;
W_beam = 0.1;
T_beam = 0.05;
rho = 2700.0;
E   = 7.0e7;
nu  = 0.33;
nElements = 2;

beam.length = Lbeam;
beam.width = W_beam;
beam.thickness = T_beam;
beam.density = rho;
beam.youngs_modulus = E;
beam.poisson_ratio = nu;
beam.elements_num = nElements;
beam.fixed_root = true;

femBeam = FEM_Beam(beam);
[~, K_beam] = femBeam.get_matrices_3d();
[feShapeMatrix, stiffnessDofs] = femBeam.build_direct_fe_shape_matrix();
nFlexibleDofs = size(feShapeMatrix, 2);

Kff = full(K_beam(stiffnessDofs, stiffnessDofs));
Kff = 0.5 * (Kff + Kff.');

if size(Kff, 1) ~= nFlexibleDofs
    error('Kff size does not match the direct FE coordinate size.');
end

% Numerical quadrature for the FFRF mass integrals
nx = 4; ny = 3; nz = 3;
[u0, S, weights] = femBeam.build_ffrf_data(feShapeMatrix, nx, ny, nz);

% No structural damping
Dff = zeros(nFlexibleDofs);

params.density = rho;
params.u0      = u0;
params.S       = S;
params.weights = weights;
params.Kff     = Kff;
params.Dff     = Dff;

% FlexBody state: q = [quaternion(4); translation(3); eta(nFlexibleDofs)]
params.q = [1; 0; 0; 0; ...
            0; 0; 0; ...
            zeros(nFlexibleDofs, 1)];
params.qdot = zeros(7 + nFlexibleDofs, 1);

rod = FlexBody(params);

%% Single flexible link setup
NB = 1;
model.NB = NB;
model.parent = 0;
model.jtype = {'Rz'};
model.Xtree = {eye(6)};
model.flexbody = cell(NB, 1);
model.flexbody{1} = rod;
model.link_type = {'flexible'};

tipNodeId = nElements + 1;
tipDofs = femBeam.get_node_dofs(tipNodeId);
tipShape6D = feShapeMatrix(tipDofs, :);

Phi_tip = [tipShape6D(4:6, :); ...  % rx, ry, rz
           tipShape6D(1:3, :)];     % ux, uy, uz
model.Phi = {Phi_tip};              % 单杆模型，只有 1 个 Cell
model.gravity = zeros(6, 1);

%% Dynamic State Initialization
nEta = nFlexibleDofs;               % 定义弹性自由度数 (为 12)
x0 = zeros(2*NB + 2*nEta, 1);       % 正确开辟状态向量内存 [q; qd; eta; eta_d]

q = x0(1:NB);
qd = x0(NB + (1:NB));
eta = x0(2*NB + (1:nEta));
eta_d = x0(2*NB + nEta + (1:nEta));

tau = 0.1;                          % 单关节扭矩驱动 (标量)

[qdd, eta_dd] = FD_flex(model, q, qd, tau, eta, eta_d);
disp('beam mass:')
disp(Lbeam*W_beam*T_beam*rho);

disp('Joint acceleration qdd:');
disp(qdd);
